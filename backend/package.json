{
  "name": "devgraph-backend",
  "version": "1.0.0",
  "description": "Backend for DevGraph - Developer skill, project and career recommendation platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "seed": "ts-node src/database/seed.ts",
    "cleanup": "ts-node src/database/cleanup.ts",
    "verify": "ts-node src/database/verify.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "neo4j-driver": "^5.23.0",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "ts-node-dev": "^2.0.0"
  }
}
